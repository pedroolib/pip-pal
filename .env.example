# Optional: copy to .env (gitignored). Pip works without any keys, through the hosted proxy (src/proxy/).
# Your own keys go direct instead (needed on the demo Mac, so the pitch doesn't depend on the proxy).
# Claude writes steps, questions, plans and summaries.
ANTHROPIC_API_KEY=
# Jev classifies the triage.
TYPESAFE_API_KEY=
# Optional: haiku (default) or sonnet
PIP_MODEL=haiku
# Optional: 1 starts with Sam's demo data and skips onboarding (needed on the demo Mac)
# PIP_DEMO=1
