# Optional: copy to .env (gitignored). Without anything here, Pip answers from the demo fixtures.
# Live AI: the team's access token for the hosted proxy (src/proxy/), which holds the API keys.
# Ask the team for it privately; it is never committed. To create or replace it: node scripts/new-proxy-token.mjs
PIP_ACCESS_TOKEN=
# Optional: your own keys go direct to the providers instead of through the proxy.
# ANTHROPIC_API_KEY=
# TYPESAFE_API_KEY=
# Optional: haiku (default) or sonnet
PIP_MODEL=haiku
# Optional: 1 starts with Sam's demo data and skips onboarding (needed on the demo Mac)
# PIP_DEMO=1
