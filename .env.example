# Copy to .env (gitignored) and fill in. Keys are read only by the main process.
# Claude writes steps, questions, plans and summaries. Without it, those use the demo fixtures.
ANTHROPIC_API_KEY=
# Jev classifies the triage. Without it, the triage uses the demo fixture.
TYPESAFE_API_KEY=
# Optional: haiku (default) or sonnet
PIP_MODEL=haiku
# Optional: 1 starts with Sam's demo data and skips onboarding (needed on the demo Mac)
# PIP_DEMO=1
