# Copy to .env (gitignored) and fill in. Keys are read only by the main process.
# Without ANTHROPIC_API_KEY the app keeps using the fixture decode.
ANTHROPIC_API_KEY=
# Optional: Jev classifies in parallel; if missing or failing, Claude classifies.
TYPESAFE_API_KEY=
# Optional: haiku (default) or sonnet
PIP_MODEL=haiku
